; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Veraball"
run/main_scene="res://data/scenes/menu/main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.png"
target_fps=60

[audio]

fx_volume_scale=1.0
stream_volume_scale=0.6

[autoload]

Game="*res://data/scripts/autoload/game.gd"
Levels="*res://data/scripts/autoload/levels.gd"
Music="*res://data/scenes/autoload/music.tscn"
Options="*res://data/scripts/autoload/options.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("smoothing")

[importer_defaults]

texture={
"flags/filter": true,
"flags/mipmaps": true
}

